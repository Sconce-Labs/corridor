pragma language_version >= 0.24;
import CompactStandardLibrary;

// ─────────────────────────────────────────────────────────────────────────────
// Corridor — Midnight credential registry
//
// This is the credential-CUSTODY layer of the hybrid design (see ARCHITECTURE.md).
// A regulated issuer, after running KYC once off-chain, records a credential
// COMMITMENT here. The holder keeps the opening (secret + attributes) in their
// own Midnight private state and later proves eligibility with a Noir circuit
// that the Stellar side verifies.
//
// WHAT IS PUBLIC (on the Midnight ledger, visible to anyone):
//   • issuers        — Set<Bytes<32>>            — registered issuer ids. Issuer
//                      identity is public BY DESIGN (accountability). Holder
//                      identity never is.
//   • credentials    — MerkleTree<32, Bytes<32>> — commitments to issued
//                      credentials. A commitment is
//                      Poseidon2(holderSecret, tier, expiry, issuerId, salt);
//                      it reveals nothing about the holder or the attributes.
//   • revoked        — MerkleTree<32, Bytes<32>> — sparse tree of revoked
//                      credential slots (slot = Poseidon2(commitment)).
//   • epoch          — Counter                   — bumped on every tree write so
//                      the Stellar relayer knows when to re-sync roots.
//   • admin          — Bytes<32>                 — governance key hash.
//
// WHAT IS PRIVATE (witness, never on-chain):
//   • issuerSk       — the issuer's secret; only its hash (issuerId) is public.
//   • everything about the holder and their attributes — those never reach this
//     contract at all; only the commitment does.
//
// Compiles clean with the Compact compiler in CI ("Compiling 4 circuits").
// Still owed before deploy (M4): simulator tests, Preprod deployment, and a
// review of the issuer-auth model (see registerIssuer / issueCredential).
// ─────────────────────────────────────────────────────────────────────────────

export ledger admin: Bytes<32>;
export ledger issuers: Set<Bytes<32>>;
export ledger credentials: MerkleTree<32, Bytes<32>>;
export ledger revoked: MerkleTree<32, Bytes<32>>;
export ledger epoch: Counter;

// One-time bootstrap: set the governance key. `adminSk` is the witness; only
// its hash is stored.
export circuit initAdmin(adminSk: Bytes<32>): [] {
    assert(admin == default<Bytes<32>>, "admin already set");
    admin = disclose(persistentHash<Bytes<32>>(adminSk));
}

// Admin registers an issuer. The issuer id is public.
export circuit registerIssuer(adminSk: Bytes<32>, issuerId: Bytes<32>): [] {
    assert(persistentHash<Bytes<32>>(adminSk) == admin, "not admin");
    issuers.insert(disclose(issuerId));
    epoch.increment(1);
}

// A registered issuer records a credential commitment. The issuer proves
// control of `issuerId` by knowing `issuerSk`; the commitment is disclosed
// (it is opaque), the attributes behind it never enter the circuit.
export circuit issueCredential(issuerSk: Bytes<32>, commitment: Bytes<32>): [] {
    const issuerId = persistentHash<Bytes<32>>(issuerSk);
    assert(issuers.member(disclose(issuerId)), "unknown issuer");
    credentials.insert(disclose(commitment));
    epoch.increment(1);
}

// Issuer (or admin) revokes a credential by inserting its slot into the
// revocation tree. `slot` = Poseidon2(commitment), matching the Noir circuit.
export circuit revokeCredential(issuerSk: Bytes<32>, slot: Bytes<32>): [] {
    const issuerId = persistentHash<Bytes<32>>(issuerSk);
    assert(
        issuers.member(disclose(issuerId)) || persistentHash<Bytes<32>>(issuerSk) == admin,
        "not authorized to revoke"
    );
    revoked.insert(disclose(slot));
    epoch.increment(1);
}
