{
  "name": "@corridor/verify",
  "version": "0.0.0",
  "description": "Client SDK for Corridor — build an eligibility witness, request a proof, and present it to a Stellar corridor.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "keywords": ["stellar", "soroban", "midnight", "zero-knowledge", "kyc", "privacy"],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sconce-Labs/corridor",
    "directory": "packages/verify"
  },
  "peerDependencies": {
    "@stellar/stellar-sdk": ">=12"
  },
  "devDependencies": {
    "tsx": "^4.23.1",
    "typescript": "^5.6.0"
  }
}
